# ─── Copy this to .env and fill in your values ────────────────────────────────
# NEVER commit .env to git. It contains secrets.
# The .gitignore already excludes it.

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# These must match what's in docker-compose.yml
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=prscope
POSTGRES_PASSWORD=prscope_dev
POSTGRES_DB=prscope

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a real secret key with: openssl rand -hex 32
SECRET_KEY=change-me-before-deploying-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GitHub OAuth (fill in Week 1, Day 7) ──────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── LLM (fill in Week 2, Day 14) ─────────────────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Or Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
